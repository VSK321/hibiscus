<p>Length of "~(self.val)~" is ~(len(self.val))~</p>
<input rosefocusout="ReturnTrue" roseinput="InputVal" />


<div class="container">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <img src="@UserProfile.PictureUrl" alt="@UserProfile.Name" class="img-fluid rounded-circle me-3" style="width: 100px; height: 100px;" />
                        <div>
                            <h5 class="card-title">@UserProfile.Name</h5>
                            <p class="card-text">@UserProfile.Role</p>
                            <p class="card-text"><small class="text-muted">@UserProfile.Location</small></p>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-outline-secondary me-2" @onclick="NavigateToSettings"><img src="/settings.png" alt="Settings" /></button>
                        <button class="btn btn-primary">Contact</button>
                    </div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">About</h6>
                    <p class="card-text">@UserProfile.Summary</p>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Experience</h6>
                    @foreach (var experience in UserProfile.Experiences)
                    {
                    <p class="card-text"><strong>@experience.Title</strong> at @experience.Company (@experience.StartDate - @experience.EndDate)</p>
                    <p class="card-text">@experience.Description</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Skills</h6>
                    @foreach (var skill in UserProfile.Skills)
                    {
                    <span class="badge bg-secondary me-1">@skill</span>
                    }
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Education</h6>
                    @foreach (var education in UserProfile.Educations)
                    {
                    <p class="card-text"><strong>@education.Degree</strong> in @education.Field of study from @education.School (@education.StartYear - @education.EndYear)</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<div class="container">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <img src="@UserProfile.PictureUrl" alt="@UserProfile.Name" class="img-fluid rounded-circle me-3" style="width: 100px; height: 100px;" />
                        <div>
                            <h5 class="card-title">@UserProfile.Name</h5>
                            <p class="card-text">@UserProfile.Role</p>
                            <p class="card-text"><small class="text-muted">@UserProfile.Location</small></p>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-outline-secondary me-2" @onclick="NavigateToSettings"><img src="/settings.png" alt="Settings" /></button>
                        <button class="btn btn-primary">Contact</button>
                    </div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">About</h6>
                    <p class="card-text">@UserProfile.Summary</p>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Experience</h6>
                    @foreach (var experience in UserProfile.Experiences)
                    {
                    <p class="card-text"><strong>@experience.Title</strong> at @experience.Company (@experience.StartDate - @experience.EndDate)</p>
                    <p class="card-text">@experience.Description</p>
                    }
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Endorsements and Recommendations</h6>
                    @foreach (var endorsement in UserProfile.Endorsements)
                    {
                    <p class="card-text"><strong>@endorsement.Skill</strong> endorsed by @endorsement.Endorser (@endorsement.Relationship)</p>
                    }
                    @foreach (var recommendation in UserProfile.Recommendations)
                    {
                    <p class="card-text"><strong>@recommendation.Recommender</strong> (@recommendation.Relationship) said: "@recommendation.Text"</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Skills</h6>
                    @foreach (var skill in UserProfile.Skills)
                    {
                    <span class="badge bg-secondary me-1">@skill</span>
                    }
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Education</h6>
                    @foreach (var education in UserProfile.Educations)
                    {
                    <p class="card-text"><strong>@education.Degree</strong> in @education.Field of study from @education.School (@education.StartYear - @education.EndYear)</p>
                    }
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Interests and Hobbies</h6>
                    @foreach (var interest in UserProfile.Interests)
                    {
                    <span class="badge bg-secondary me-1">@interest</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
