<p>Counter is at ~(self.x)~ </p>
<button class="btn btn-primary" roseclick="AddOne">Add</button>
<button class="btn btn-primary" roseclick="SubOne">Subtract</button>
<button class="btn btn-primary" roseclick="test" roseid="~(self.x)~">Add Counter Value</button>

~if self.x > 5{
<p>Counter is greater than 5</p>
}
~else{
<p>Counter is less than or equal to 5</p>
    ~if self.x == 5{
        <p>Counter is at 5</p>
    }
    ~exe~rose_line += (lambda: "Counter is, currently, at 1" if self.x == 1 else "")()
}

~(await self.first.main("first"))~